# Autarch Protocol Backend Environment Configuration

# Network & RPC
COOKIE_RPC_URL=https://rpc.cookiescan.io
COOKIE_WS_RPC_URL=wss://rpc.cookiescan.io

# Delegated Agent Keypair (Secret Key Base58) for signing CPI requests to Smart Vault PDA
# DO NOT COMMIT REAL PRIVATE KEYS
COOKIE_PRIVATE_KEY=your_base58_private_key_here

# Financial Safety Guardrails (Enforced by PolicyLayer)
COOKIE_MAX_TRADE_COOK=100
COOKIE_SLIPPAGE_BPS=500

# PolicyLayer Configuration Path
POLICY_PATH=../docs/policy.json

# cookie-mcp Server Execution Command (STDIO)
COOKIE_MCP_SERVER_COMMAND=npx
COOKIE_MCP_SERVER_ARGS=-y @cookiechain/cookie-mcp

# Express Server Port
PORT=4000
