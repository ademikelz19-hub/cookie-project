# ==============================================================================
# GRANT AGENT PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 16)
# Local: postgresql+psycopg2://postgres:postgres@localhost:5432/grant_agent
# Cloud SQL Proxy: postgresql+psycopg2://grant_agent_user:password@127.0.0.1:5432/grant_agent
# Cloud Run Unix Socket: postgresql+psycopg2://grant_agent_user:password@/grant_agent?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/grant_agent

# AI / LLM Configuration (Google Gemini / Vertex AI)
GEMINI_API_KEY_1=your_primary_gemini_api_key_here
GEMINI_API_KEY_2=your_secondary_gemini_api_key_here
GEMINI_API_KEY_3=your_tertiary_gemini_api_key_here
GEMINI_API_KEY=your_primary_gemini_api_key_here
PRIMARY_GEMINI_MODEL=gemini-3.8-flash
FALLBACK_GEMINI_MODEL=gemini-3.5-flash
SECONDARY_FALLBACK_GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_SECONDS=1.0
GEMINI_REQUEST_TIMEOUT_SECONDS=30.0

# Google Cloud Project & Storage
GCP_PROJECT_ID=grant-agent-gcp
GCP_REGION=us-central1
GCS_DOCUMENTS_BUCKET=grant-agent-gcp-grant-documents-vault
GCS_SCREENSHOTS_BUCKET=grant-agent-gcp-grant-browser-artifacts
STORAGE_PROVIDER=local   # 'local' or 'gcs'
LOCAL_UPLOAD_DIR=./uploads

# Browser Automation & Human Gate Interruption
HEADLESS_BROWSER=True
BROWSER_TIMEOUT_MS=30000
SCREENSHOT_INTERVAL_MS=2000
HUMAN_GATE_MAX_WAIT_SECONDS=900

# Mock Grant Portal (For Local Sandbox Testing)
MOCK_PORTAL_URL=http://127.0.0.1:8088

# Next.js Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="Grant Agent"
NEXT_PUBLIC_APP_VERSION=1.0.0
